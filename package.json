{
    "name": "testpilot",
    "version": "0.1.0",
    "description": "TestPilot is a GenAI enabler for quick test script generation and automation",
    "private": true,
    "type": "module",
    "author": "esproenca <eduardo.proenca@parceiros.nos.pt>",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/edupro26/testpilot.git"
    },
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "testpilot": "node src/main.ts",
        "postinstall": "playwright install chromium",
        "lint": "eslint .",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "typecheck": "tsc",
        "test": "vitest run",
        "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@playwright/mcp": "^0.0.83",
        "@playwright/test": "^1.64.1",
        "commander": "^15.0.0",
        "openai": "^7.45.1",
        "typescript": "~6.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^24",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "prettier": "^3.9.10",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.0.5"
    },
    "overrides": {
        "@playwright/mcp": {
            "playwright": "$@playwright/test",
            "playwright-core": "$@playwright/test"
        }
    },
    "bin": {
        "testpilot": "src/main.ts"
    }
}
