
# The provider to use by default
# =============================================================
#   azure_openai    - Set Azure OpenAI as the provider
LLM_PROVIDER=azure_openai

# =============================================================
# LLM CONFIGURATION (Anthropic)
# =============================================================
#   API_KEY         - secret api key for the resource above
#   MODEL_NAME      - the LLM model, e.g. claude-4.6-sonnet
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# =============================================================
# LLM CONFIGURATION (OpenAI)
# =============================================================
#   API_KEY         - secret api key for the resource above
#   MODEL_NAME      - the LLM model, e.g. gpt-5.6-luna
OPENAI_API_KEY=
OPENAI_MODEL=

# =============================================================
# LLM CONFIGURATION (Azure OpenAI)
# =============================================================
#   API_KEY         - secret key for the resource above
#   DEPLOYMENT_NAME - the name of the deployment in Azure
#   MODEL_NAME      - the LLM model, e.g. gpt-5.6-luna
#   API_VERSION     - OpenAI API version, e.g. 2025-04-01-preview
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_DEPLOYMENT_NAME=
AZURE_MODEL_NAME=
OPENAI_API_VERSION=

# Playwright MCP URL
# =============================================================
PLAYWRIGHT_MCP_URL=http://localhost:8931/mcp

# Log level for the application: DEBUG | INFO | WARNING | ERROR
# =============================================================
LOG_LEVEL=INFO